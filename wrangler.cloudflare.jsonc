{
  "name": "back2u-cloud",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "back2u-cloud",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
