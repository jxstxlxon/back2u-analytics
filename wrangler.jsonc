{
  "name": "back2u-cloud",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "back2u-cloud",
      "database_id": "7ce4f8ca-8198-4be9-9543-aa12a7dc1992"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "78cc5d1f-5a98-47e9-9864-d143a9dcc363"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "DASHBOARD_PASSWORD",
      "SESSION_SECRET",
      "BACK2U_GOOGLE_FEED_SECRET"
    ]
  }
}
